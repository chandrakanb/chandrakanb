; TTL Macro File
setbaud 115200
connect 'COM5'

; Send initial debug commands
sendln 'MCU_DEBUG00'
sendln 'MCU_DEBUG01'

; Send variant code 4 times
sendln 'MCU_DEBUG14545942413101'
wait 1
sendln 'MCU_DEBUG14545942413101'
wait 1
sendln 'MCU_DEBUG14545942413101'
wait 1
sendln 'MCU_DEBUG14545942413101'
wait 1

; Disconnect and end
disconnect
end
