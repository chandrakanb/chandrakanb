def status_to_color(status):
    if status == "Pass":
        return "#4CAF50", "#fff"
    elif status == "Fail":
        return "#f44336", "#000"
    elif status == "VERIFYMANUALLY":
        return "#ffff00", "#000"
    else:
        return "#fff", "#000"

